    "@sinclair/typebox": "^0.34.33",
    "fastify": "^5.3.3",
    "fastify-plugin": "^6.0.0",
    "pdfkit": "^0.17.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/pdfkit": "^0.13.9",
    "typescript": "^5.8.3"
  }
}
