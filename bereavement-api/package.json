{
  "name": "@rascode/bereavement-api",
  "version": "0.1.0",
  "description": "Bereavement arrangements API for dbui — gather documents, beloved biography, AI obituaries, and service PDF packages",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/server.ts",
    "start": "node --experimental-strip-types src/server.ts",
    "typecheck": "tsc --noEmit",
